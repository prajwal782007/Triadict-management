# Supabase Frontend Credentials (Safe to expose)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Server-Side Credentials (NEVER EXPOSE IN FRONTEND - Used by Discord Bot in Stage 3)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Discord Bot Token (NEVER EXPOSE IN FRONTEND - Used by Discord Bot in Stage 3)
# DISCORD_BOT_TOKEN=your_discord_bot_token
